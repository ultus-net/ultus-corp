#!/usr/bin/env python3
"""Bring one bounded lab scenario up, record it, and take it down again."""

from __future__ import annotations

import argparse
import ipaddress
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(HERE))

import render  # noqa: E402
import state as runstate  # noqa: E402
import deploy  # noqa: E402

os.environ.setdefault("LIBVIRT_DEFAULT_URI", "qemu:///system")
RUN = Path(os.environ.get("LAB_RUN_DIR") or ROOT / "run")
SPEC = ROOT / "lab" / "lab.toml"


def virsh(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["virsh", *args], capture_output=True, text=True, cwd=ROOT)


def names(*args: str) -> list[str]:
    done = virsh(*args)
    return [line.strip() for line in done.stdout.splitlines() if line.strip()]


def fail(message: str, code: int = 1) -> "None":
    print(message, file=sys.stderr)
    raise SystemExit(code)


def load_spec() -> render.Spec:
    try:
        return render.load(SPEC)
    except ValueError as exc:
        fail(f"spec error: {exc}")


def ssh_key() -> str:
    secrets = ROOT / "lab-secrets"
    secrets.mkdir(mode=0o700, exist_ok=True)
    key = secrets / "id_ed25519"
    if not key.exists():
        subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "ultus-corp", "-f", str(key)],
            check=True,
        )
        os.chmod(key, 0o600)
    return (secrets / "id_ed25519.pub").read_text(encoding="utf-8").strip()


def make_seed_iso(seed_dir: Path, iso: Path) -> None:
    tool = shutil.which("xorriso")
    if tool:
        command = [tool, "-as", "mkisofs", "-quiet"]
    elif shutil.which("genisoimage"):
        command = [shutil.which("genisoimage"), "-quiet"]
    else:
        raise RuntimeError("xorriso or genisoimage is required for the NoCloud seed")
    command += [
        "-output",
        str(iso),
        "-volid",
        "cidata",
        "-joliet",
        "-rock",
        str(seed_dir),
    ]
    subprocess.run(command, check=True, cwd=ROOT)
    # The qemu user reads the ISO, and it holds only public key material.
    os.chmod(iso, 0o644)


def create_seed(
    node: render.Node,
    spec: render.Spec,
    run_dir: Path,
    public_key: str,
    deployment_id: str,
) -> Path:
    node_dir = run_dir / "seed" / node.name
    node_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(run_dir / "seed", 0o700)
    os.chmod(node_dir, 0o700)
    seed = render.seed_files(node, spec, public_key, deployment_id=deployment_id)
    for name, content in seed.items():
        target = node_dir / name
        target.write_text(content, encoding="utf-8")
        os.chmod(target, 0o600)
    return node_dir


def disk_builder() -> Path:
    configured = os.environ.get("LAB_DISK_BUILDER")
    if configured:
        return Path(configured)
    return ROOT / "lab" / "build-disk.sh"


def build_disk(role: str, target: Path) -> None:
    builder = disk_builder()
    if not builder.is_file():
        fail(
            f"no disk builder at {builder}; Task 6 provides it, "
            "or set LAB_DISK_BUILDER"
        )
    done = subprocess.run(
        [str(builder), role, str(target)], cwd=ROOT, capture_output=True, text=True
    )
    if done.returncode != 0:
        raise RuntimeError(f"disk builder failed: {done.stderr.strip()}")


def disk_provenance(volume: Path) -> tuple[str, str]:
    """The image the disk was built from, as recorded beside it.

    A disk without both sidecars cannot be checked against the guest's record,
    so it fails here rather than after a ten-minute boot.
    """
    image_id = volume.with_name(volume.name + ".id")
    digest = volume.with_name(volume.name + ".digest")
    missing = [str(path) for path in (image_id, digest) if not path.exists()]
    if missing:
        raise RuntimeError(f"disk provenance is missing: {', '.join(missing)}")
    return (
        image_id.read_text(encoding="utf-8").strip(),
        digest.read_text(encoding="utf-8").strip(),
    )


def consume_seed(state: dict, state_file: Path, scenario: str, node: render.Node) -> None:
    """Eject and delete the seed once the deployment that used it is recorded."""
    domain = f"ultus-{scenario}-{node.name}"
    done = virsh("change-media", domain, "sda", "--eject", "--live", "--config")
    if done.returncode != 0:
        raise RuntimeError(f"eject {domain}: {done.stderr.strip()}")
    wanted = {
        f"ultus-{scenario}-{node.name}-seed",
        f"ultus-{scenario}-{node.name}-seed.iso",
    }
    for resource in state["resources"]:
        if resource["name"] in wanted:
            delete(resource)
            # Teardown keeps the entry so the run still shows what it created,
            # and tolerates the absent path on a second pass.
            resource["consumed"] = True
    runstate.write(state_file, state)


def wait_for_deployments(
    state: dict, state_file: Path, scenario: str, nodes: list[render.Node]
) -> None:
    timeout = float(os.environ.get("LAB_DEPLOY_TIMEOUT", "900"))
    for node in nodes:
        info = state["nodes"][node.name]
        _, digest = disk_provenance(Path(info["volume"]))
        record = deploy.await_record(
            info["address"], info["deployment_id"], node.role, digest, timeout=timeout
        )
        # The harness keeps the history the guest deliberately does not.
        runstate.record_deployment(state, record)
        runstate.write(state_file, state)
        consume_seed(state, state_file, scenario, node)
        print(f"{node.name} deployed as {info['deployment_id']}")


def delete(resource: dict) -> None:
    kind = resource["kind"]
    name = resource["name"]
    if kind == "domain":
        virsh("destroy", name)
        done = virsh("undefine", name)
        if done.returncode != 0:
            raise RuntimeError(f"cannot undefine {name}: {done.stderr.strip()}")
    elif kind == "network":
        virsh("net-destroy", name)
        done = virsh("net-undefine", name)
        if done.returncode != 0:
            raise RuntimeError(f"cannot undefine {name}: {done.stderr.strip()}")
    elif kind in {"volume", "seed", "seediso", "log"}:
        target = Path(resource["path"])
        if target.is_dir():
            shutil.rmtree(target, ignore_errors=True)
        else:
            target.unlink(missing_ok=True)
            if kind == "volume":
                # The provenance sidecars are part of the disk resource, so a
                # stale digest never outlives the disk it describes.
                for suffix in (".id", ".digest"):
                    target.with_name(target.name + suffix).unlink(missing_ok=True)
    else:
        raise RuntimeError(f"unknown resource kind {kind}")


def teardown(state: dict, state_file: Path) -> int:
    remaining = []
    for resource in reversed(state["resources"]):
        try:
            delete(resource)
            runstate.drop(state, resource["kind"], resource["name"])
            runstate.write(state_file, state)
        except Exception as exc:  # noqa: BLE001 - the message is the report
            remaining.append(f"{resource['kind']} {resource['name']}: {exc}")
            break
    if remaining:
        runstate.write(state_file, state)
        print("retained resources:", file=sys.stderr)
        for line in remaining:
            print(f"  {line}", file=sys.stderr)
        print(f"state kept at {state_file}", file=sys.stderr)
        print(f"recover with: lab down {state['scenario']}", file=sys.stderr)
        return 2
    state_file.unlink(missing_ok=True)
    prune_empty(state_file.parent)
    return 0


def prune_empty(scenario_dir: Path) -> None:
    """Drop the seed directory and the scenario directory once they are empty."""
    for candidate in (scenario_dir / "seed", scenario_dir):
        try:
            candidate.rmdir()
        except OSError:
            pass


def cmd_up(args: argparse.Namespace) -> int:
    if shutil.which("virsh") is None:
        fail("virsh is not installed; run lab doctor")
    spec = load_spec()
    scenario = args.scenario
    try:
        nodes = render.nodes_for(spec, scenario)
    except ValueError as exc:
        fail(str(exc))

    state_file = runstate.state_path(RUN, scenario)
    if state_file.exists():
        print(f"{scenario} is already up")
        return 0

    run_dir = RUN / scenario
    render_dir = run_dir / "render"
    render_dir.mkdir(parents=True, exist_ok=True)
    state = runstate.new(scenario)
    public_key = ssh_key()
    for node in nodes:
        state["nodes"][node.name] = {
            "address": node.interfaces[0].address,
            "domain": f"ultus-{scenario}-{node.name}",
            "deployment_id": render.new_deployment_id(),
            "volume": str(run_dir / f"ultus-{scenario}-{node.name}.qcow2"),
        }
    runstate.write(state_file, state)

    try:
        for segment in render.scenario_segments(spec, scenario):
            name = f"ultus-{scenario}-{segment.name}"
            xml = render_dir / f"{scenario}-{segment.name}.network.xml"
            xml.write_text(render.network_xml(scenario, segment, spec), encoding="utf-8")
            done = virsh("net-define", str(xml))
            if done.returncode != 0:
                raise RuntimeError(f"net-define {name}: {done.stderr.strip()}")
            runstate.add(state, "network", name)
            runstate.write(state_file, state)
            done = virsh("net-start", name)
            if done.returncode != 0:
                raise RuntimeError(f"net-start {name}: {done.stderr.strip()}")

        for node in nodes:
            seed_dir = create_seed(
                node, spec, run_dir, public_key, state["nodes"][node.name]["deployment_id"]
            )
            runstate.add(
                state,
                "seed",
                f"ultus-{scenario}-{node.name}-seed",
                path=str(seed_dir),
                mode="0700",
            )
            runstate.write(state_file, state)

            iso = run_dir / f"ultus-{scenario}-{node.name}-seed.iso"
            make_seed_iso(seed_dir, iso)
            runstate.add(
                state,
                "seediso",
                iso.name,
                path=str(iso),
                mode="0644",
            )
            runstate.write(state_file, state)

            volume = run_dir / f"ultus-{scenario}-{node.name}.qcow2"
            build_disk(node.role, volume)
            runstate.add(
                state,
                "volume",
                volume.name,
                path=str(volume),
            )
            runstate.write(state_file, state)

            xml = render_dir / f"{node.name}.xml"
            xml.write_text(render.domain_xml(node, spec, RUN), encoding="utf-8")
            # The expected post-deploy checksums come from the bytes the seed
            # carries, so they exist before the guest boots.
            (render_dir / f"{node.name}.managed-files.sha256").write_text(
                render.managed_manifest(node, spec), encoding="utf-8"
            )
            done = virsh("define", str(xml))
            if done.returncode != 0:
                raise RuntimeError(f"define {node.name}: {done.stderr.strip()}")
            runstate.add(state, "domain", f"ultus-{scenario}-{node.name}")
            runstate.write(state_file, state)
            done = virsh("start", f"ultus-{scenario}-{node.name}")
            if done.returncode != 0:
                raise RuntimeError(f"start {node.name}: {done.stderr.strip()}")
    except Exception as exc:  # noqa: BLE001 - teardown reports the rest
        print(f"up failed: {exc}", file=sys.stderr)
        code = teardown(state, state_file)
        return max(code, 1) if code else 1

    # A guest that booted but never recorded its deployment is not up. The VMs
    # are left running so the failure can be read from the console and the
    # journal, which a teardown would destroy.
    if os.environ.get("LAB_DEPLOY_WAIT", "") != "skip":
        try:
            wait_for_deployments(state, state_file, scenario, nodes)
        except Exception as exc:  # noqa: BLE001 - the message is the report
            print(f"deployment failed: {exc}", file=sys.stderr)
            print(f"the scenario is still up; inspect it, then lab down {scenario}")
            return 1

    print(f"{scenario} is up: {', '.join(node.name for node in nodes)}")
    return 0


def force_names(spec: render.Spec, scenario: str) -> list[tuple[str, str]]:
    """Only names the spec derives, never a bare prefix match."""
    nodes = render.nodes_for(spec, scenario)
    found = [("domain", node.name) for node in nodes]
    found += [
        ("network", segment.name)
        for segment in render.scenario_segments(spec, scenario)
    ]
    return found


def cmd_down(args: argparse.Namespace) -> int:
    spec = load_spec()
    scenario = args.scenario
    state_file = runstate.state_path(RUN, scenario)

    if not state_file.exists():
        if not args.force:
            fail(f"no state for {scenario}; refusing to guess")
        try:
            expected = force_names(spec, scenario)
        except ValueError as exc:
            fail(str(exc))
        state = runstate.new(scenario)
        removed = 0
        live_domains = set(names("list", "--all", "--name"))
        live_networks = set(names("net-list", "--all", "--name"))
        for kind, short in expected:
            full = f"ultus-{scenario}-{short}"
            live = live_domains if kind == "domain" else live_networks
            if full not in live:
                continue
            print(f"warning: inferred {kind} {full} from the spec", file=sys.stderr)
            delete({"kind": kind, "name": full})
            removed += 1
        if state["resources"]:
            runstate.write(state_file, state)
        else:
            state_file.unlink(missing_ok=True)
            prune_empty(state_file.parent)
        print(f"repaired state for {scenario}, removed {removed} resource(s)")
        return 0

    state = runstate.read(state_file)
    code = teardown(state, state_file)
    if code == 0:
        print(f"{scenario} is down")
    return code


def cmd_status(_: argparse.Namespace) -> int:
    if not RUN.is_dir():
        print("no scenarios are up")
        return 0
    found = False
    for state_file in sorted(RUN.glob("*/state.json")):
        state = runstate.read(state_file)
        found = True
        print(f"{state['scenario']}  owner {state['owner']}  {len(state['nodes'])} node(s)")
    if not found:
        print("no scenarios are up")
    return 0


def cmd_test(args: argparse.Namespace) -> int:
    script = ROOT / "tests" / "scenarios" / f"{args.scenario}.sh"
    if not script.is_file():
        fail(f"no scenario test at {script}")
    return subprocess.run(["bash", str(script)], cwd=ROOT).returncode


def uncached_roles() -> list[str]:
    """Roles with no built disk, which is the only case that needs root."""
    try:
        spec = render.load(SPEC)
    except ValueError:
        return []
    cache = ROOT / "build" / "vm" / "cache"
    return sorted(
        role
        for role in {node.role for node in spec.nodes}
        # A disk without the id recorded beside it cannot be proven current, so
        # it does not save the rootful step.
        if not any(
            p.with_name(p.name + ".id").exists() for p in cache.glob(f"{role}-*.qcow2")
        )
    )


def traversable(path: Path) -> bool:
    """Every existing ancestor must be executable, or qemu cannot open a file."""
    for part in [path, *path.parents]:
        if part.exists() and not part.stat().st_mode & 0o001:
            return False
    return True


def host_uplinks() -> list[str]:
    """The host's own address plan, never the lab's bridges.

    A physical interface has a `device` link in sysfs. The interface carrying
    the default route is included even when it is virtual, because that is the
    path off the host. Every non-default route on those interfaces is included
    too, so a VPN or a second LAN is compared as well.
    """
    try:
        links = json.loads(
            subprocess.run(
                ["ip", "-j", "addr", "show"], capture_output=True, text=True, check=True
            ).stdout
        )
        routes = json.loads(
            subprocess.run(
                ["ip", "-j", "route", "show"],
                capture_output=True,
                text=True,
                check=True,
            ).stdout
        )
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read the host address plan: {exc}") from exc

    uplinks = {
        route.get("dev")
        for route in routes
        if route.get("dst") == "default" and route.get("dev")
    }
    for link in links:
        name = link.get("ifname")
        if name and Path(f"/sys/class/net/{name}/device").exists():
            uplinks.add(name)

    prefixes: set[str] = set()

    def add_network(value: str) -> None:
        """An address carries its prefix; the caller compares networks."""
        try:
            prefixes.add(str(ipaddress.ip_network(value, strict=False)))
        except ValueError as exc:
            raise RuntimeError(f"cannot read the host prefix {value}: {exc}") from exc

    for link in links:
        if link.get("ifname") not in uplinks:
            continue
        for info in link.get("addr_info", []):
            if info.get("family") == "inet":
                add_network(f"{info['local']}/{info['prefixlen']}")
    for route in routes:
        dst = route.get("dst")
        if not dst or dst == "default" or ":" in dst:
            continue
        if route.get("dev") in uplinks:
            add_network(dst)
    return sorted(prefixes)


def cmd_doctor(args: argparse.Namespace) -> int:
    if args.host_uplinks:
        try:
            prefixes = host_uplinks()
        except RuntimeError as exc:
            fail(str(exc))
        if not prefixes:
            fail("no host uplink addresses found; refusing to call the lab disjoint")
        print("\n".join(prefixes))
        return 0

    problems = []
    if sys.version_info < (3, 11):
        problems.append("python 3.11 or newer")
    if not Path("/dev/kvm").exists():
        problems.append("/dev/kvm")
    for tool in ("virsh", "qemu-img"):
        if shutil.which(tool) is None:
            problems.append(tool)
    if shutil.which("xorriso") is None and shutil.which("genisoimage") is None:
        problems.append("xorriso or genisoimage")
    podman = os.environ.get("LAB_PODMAN", "podman").split()
    if shutil.which(podman[0]) is None:
        problems.append(podman[0])
    else:
        pending = uncached_roles()
        if pending:
            rootless = subprocess.run(
                [*podman, "info", "--format", "{{.Host.Security.Rootless}}"],
                capture_output=True,
                text=True,
            )
            if rootless.stdout.strip() == "true":
                problems.append(
                    "rootful podman for an uncached disk ("
                    + ", ".join(pending)
                    + "); set LAB_PODMAN='sudo podman'"
                )
    free = shutil.disk_usage(ROOT).free
    if free < 10 * 1024**3:
        problems.append("10 GiB free disk")
    if not traversable(RUN):
        problems.append(
            f"{RUN} is unreachable for the qemu user "
            "(chmod o+x each parent directory, or set LAB_RUN_DIR)"
        )
    if problems:
        print("missing: " + ", ".join(problems), file=sys.stderr)
        return 1
    print("host looks ready")
    return 0


def cmd_prune(args: argparse.Namespace) -> int:
    live = set(names("list", "--all", "--name"))
    for state_file in RUN.glob("*/state.json"):
        for resource in runstate.read(state_file)["resources"]:
            if resource["kind"] == "domain" and resource["name"] in live:
                print(f"refusing: {resource['name']} is running", file=sys.stderr)
                return 1
    cache = ROOT / "build" / "out"
    if cache.is_dir():
        shutil.rmtree(cache)
    disks = ROOT / "build" / "vm" / "cache"
    if disks.is_dir():
        shutil.rmtree(disks)
    print("pruned unused build output")
    return 0


def cmd_egress(args: argparse.Namespace) -> int:
    spec = load_spec()
    try:
        nodes = render.nodes_for(spec, args.scenario)
    except ValueError as exc:
        fail(str(exc))
    if not any(node.role == "hub" for node in nodes):
        fail(f"{args.scenario} has no hub node; egress is a hub-only toggle")
    name = f"ultus-{args.scenario}-egress"
    if args.state == "on":
        xml = RUN / args.scenario / "render" / f"{name}.network.xml"
        xml.parent.mkdir(parents=True, exist_ok=True)
        xml.write_text(
            "<network>\n"
            f"  <name>{name}</name>\n"
            "  <forward mode='nat'/>\n"
            "  <bridge name='virbr-ultus'/>\n"
            "  <ip address='10.255.255.1' prefix='24'/>\n"
            "</network>\n",
            encoding="utf-8",
        )
        virsh("net-define", str(xml))
        virsh("net-start", name)
    else:
        virsh("net-destroy", name)
        virsh("net-undefine", name)
    print(f"egress {args.state} for {args.scenario}")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="lab")
    sub = parser.add_subparsers(dest="command", required=True)

    up = sub.add_parser("up")
    up.add_argument("scenario")
    up.set_defaults(func=cmd_up)

    down = sub.add_parser("down")
    down.add_argument("scenario")
    down.add_argument("--force", action="store_true")
    down.set_defaults(func=cmd_down)

    sub.add_parser("status").set_defaults(func=cmd_status)

    test = sub.add_parser("test")
    test.add_argument("scenario")
    test.set_defaults(func=cmd_test)

    doctor = sub.add_parser("doctor")
    doctor.add_argument("--host-uplinks", action="store_true")
    doctor.set_defaults(func=cmd_doctor)
    prune = sub.add_parser("prune")
    prune.add_argument("--all", action="store_true")
    prune.set_defaults(func=cmd_prune)

    egress = sub.add_parser("egress")
    egress.add_argument("state", choices=["on", "off"])
    egress.add_argument("scenario")
    egress.set_defaults(func=cmd_egress)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
