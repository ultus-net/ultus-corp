[Unit]
Description=Apply the delivered ultus-corp configuration
Wants=network-online.target
After=cloud-init.service network-online.target
# The applier restarts named and unbound onto the delivered files. Ordering
# those units after this one deadlocks the restart: the queued job waits for
# the applier to finish while the applier waits for the job.
Before=ultus-role-install.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ultus-corp/provision.sh

[Install]
WantedBy=ultus-role-install.target
