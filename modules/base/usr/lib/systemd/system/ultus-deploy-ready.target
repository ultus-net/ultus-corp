[Unit]
Description=ultus-corp deployment ready
Documentation=file:/usr/libexec/ultus-corp/finalize.sh
# cloud-init starts this target after it has enabled the finalize instance for
# this deployment, so the target pulls that instance in. It is not enabled in
# the image: a target in the boot transaction would resolve its wants before
# cloud-init ran, and the instance would never start.
After=cloud-final.service ultus-role-install.target
