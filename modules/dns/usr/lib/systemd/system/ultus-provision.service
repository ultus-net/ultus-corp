[Unit]
Description=Render the ultus-corp node configuration
Wants=network-online.target
After=cloud-init.service network-online.target
Before=named.service unbound.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ultus-corp/provision.sh

[Install]
WantedBy=multi-user.target
